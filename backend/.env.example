# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER put a real key in this file - this file IS committed to GitHub.
# ".env" itself is git-ignored.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# Created for you by:  python setup_admin.py
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
# ADMIN_SECRET_KEY=

# Optional: extra website addresses allowed to call this API (comma separated).
# localhost / 127.0.0.1 on any port and civic-lens1.vercel.app are already allowed.
# CORS_ORIGINS=https://my-other-site.example.com

# Optional (local development only): FLASK_DEBUG=1 turns on auto-reload.
# Leave unset on PythonAnywhere.
